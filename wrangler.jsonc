{
	// Pure-static site deployed with `npx wrangler deploy` (Workers Static Assets).
	// Build output directory is `./build` (see `build.outDir` in vite.config.ts).
	"name": "coderbyheart-photos",
	"compatibility_date": "2026-09-06",
	"assets": {
		"directory": "./build",
		// Single Page Application: serve `/index.html` for all unmatched routes
		// (client-side routing in `src/App.tsx`).
		"not_found_handling": "single-page-application"
	}
}
